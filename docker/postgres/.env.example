# PostgreSQL Configuration
# Copy this file to postgres_config/.env and update with your values

# PostgreSQL Admin (Root) Credentials
# These are used to initialize the PostgreSQL container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_INITDB_ARGS=

# Port Configuration
POSTGRES_PORT=5432

# Application-Specific Credentials
# These can be created manually or through application setup scripts

# Airflow Database
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow

# Future Applications (uncomment and modify as needed)
# APP2_DB_USER=app2
# APP2_DB_PASSWORD=app2_password
# APP2_DB_NAME=app2_db

# Backup and Maintenance
POSTGRES_BACKUP_RETENTION_DAYS=7
POSTGRES_LOG_RETENTION_DAYS=7
