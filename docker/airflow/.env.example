# Apache Airflow Environment Configuration
# Copy this file to airflow_config/.env and update with your values
#
# NOTE: Database credentials are loaded from postgres/postgres_config/.env
# The connection string is constructed automatically in docker-compose.yml

# Airflow Core Settings
AIRFLOW_HOME=/home/airflow
AIRFLOW__CORE__DAGS_FOLDER=/home/airflow/dags
AIRFLOW__CORE__LOGS_FOLDER=/home/airflow/logs
AIRFLOW__CORE__PLUGIN_FOLDER=/home/airflow/plugins

# Executor Configuration
# Options: SequentialExecutor, LocalExecutor, CeleryExecutor
AIRFLOW__CORE__EXECUTOR=LocalExecutor

# Fernet Key (for encrypting sensitive data)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=

# Airflow Web UI Settings
AIRFLOW__WEBSERVER__ENABLE_PROXY_FIX=True
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=False
AIRFLOW__WEBSERVER__SECRET_KEY=

# Email Configuration (Optional)
AIRFLOW__SMTP__SMTP_HOST=smtp.gmail.com
AIRFLOW__SMTP__SMTP_PORT=587
AIRFLOW__SMTP__SMTP_USER=your-email@gmail.com
AIRFLOW__SMTP__SMTP_PASSWORD=
AIRFLOW__SMTP__SMTP_MAIL_FROM=airflow@yourdomain.com

# Service Ports
AIRFLOW_WEBSERVER_PORT=8080

# Optional: Redis Configuration (for CeleryExecutor)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
AIRFLOW__CELERY__BROKER_URL=redis://redis:6379/0
AIRFLOW__CELERY__RESULT_BACKEND=redis://redis:6379/0
