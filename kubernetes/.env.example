# Kubernetes Environment Configuration
# Copy this file to .env and update the values
# DO NOT commit .env to version control!

# MongoDB Credentials
MONGODB_ADMIN_USER=admin
MONGODB_ADMIN_PASSWORD=change-me-in-production

# PostgreSQL Credentials
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change-me-in-production
POSTGRES_AIRFLOW_USER=airflow
POSTGRES_AIRFLOW_PASSWORD=airflow

# Airflow Credentials
AIRFLOW_FERNET_KEY=generate-with-python-script
AIRFLOW_WEBSERVER_SECRET_KEY=change-me-in-production
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow